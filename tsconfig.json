{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2017",
    "strict": true,
    "moduleResolution": "node",
    "baseUrl": "src",
    "paths": {
      "@/*": ["./*"]
    },
    "rootDirs": ["./src", "./tests"],
    "resolveJsonModule": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "strictNullChecks": true,
  },
  "include": ["src/**/*","tests"],
  "exclude": ["node_modules"]
}
